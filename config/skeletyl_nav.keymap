// Define scroll speed BEFORE including pointing.h
// #define ZMK_POINTING_DEFAULT_MOVE_VAL 600

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1100
#define ZMK_POINTING_DEFAULT_SCRL_VAL 2500

// #define ZMK_MOUSE_DEFAULT_SCRL_VAL 300

#include "keys_en_gb_extended.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <250>;
    flavor = "tap-preferred";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        td_dot: td_dot {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DOT";
            #binding-cells = <0>;
            bindings = <&kp GB_DOT>, <&kp COLON>;
        };

        td_comma: td_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA";
            #binding-cells = <0>;
            bindings = <&kp GB_COMMA>, <&kp SEMI>;
        };

        td_angular_bracket: td_angular_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ANGULAR_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp GB_LT>, <&kp GB_GT>;
        };

        td_slash_quest_excl: td_slash_quest_excl {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SLASH_QUEST_EXCL";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp GB_EXCL>, <&kp QUESTION>;
        };

        td_left_par: td_left_par {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LEFT_PAR";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_PARENTHESIS>,
                <&kp LEFT_BRACKET>,
                <&kp LEFT_BRACE>;
        };

        td_right_par: td_right_par {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RIGHT_PAR";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_PARENTHESIS>,
                <&kp RIGHT_BRACKET>,
                <&kp RIGHT_BRACE>;
        };

        td_slash: td_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SLASH";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp GB_BACKSLASH>;
        };

        mouse_scroll: sensor_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_SCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        morph_left_nav: morph_left_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_LEFT_NAV";
            bindings = <&to 1>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        morph_right_num: morph_right_num {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_RIGHT_NUM";
            bindings = <&to 2>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        morph_up_ext: morph_up_ext {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_UP_EXT";
            bindings = <&kp UP_ARROW>, <&to 3>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        td_b_esc: td_b_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_B_ESC";
            #binding-cells = <0>;
            bindings = <&kp B>, <&none>, <&kp ESC>;
        };

        ht_mkp_kp: ht_mkp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_MKP_KP";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        td_dollar_eur: td_dollar_eur {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DOLLAR_EUR";
            #binding-cells = <0>;
            bindings = <&kp DOLLAR>, <&kp GB_EURO>;
        };

        thumb_hrm: thumb_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        caps_lock {
            bindings = <&kp CAPS>;
            key-positions = <20 29>;
            layers = <0>;
            require-prior-idle-ms = <40>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 9>;
            require-prior-idle-ms = <40>;
            layers = <0>;
        };

        to_nav {
            bindings = <&to 1>;
            key-positions = <30 33>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        to_sym {
            bindings = <&to 2>;
            key-positions = <31 32>;
            layers = <0>;
            require-prior-idle-ms = <100>;
            timeout-ms = <65>;
        };

        to_ext {
            bindings = <&to 3>;
            key-positions = <30 31 32 33>;
            require-prior-idle-ms = <100>;
            layers = <0>;
            timeout-ms = <100>;
        };

        letter_v {
            bindings = <&kp V>;
            key-positions = <3 13>;
            layers = <0>;
        };

        letter_j {
            bindings = <&kp J>;
            key-positions = <23 13>;
            layers = <0>;
        };

        letter_z {
            bindings = <&kp Z>;
            key-positions = <6 16>;
            layers = <0>;
        };

        letter_k {
            bindings = <&kp K>;
            key-positions = <26 16>;
            layers = <0>;
        };
    };

    macros {
        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>;
            label = "UNDO";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
            label = "PASTE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp B           &kp L      &kp D           &kp C           &kp V                      &kp Z                    &kp Y          &kp O            &kp U             &td_slash_quest_excl
&kp N           &kp R      &mt LEFT_ALT T  &mt LCTRL S     &kp G                      &kp P                    &mt RCTRL H    &mt RIGHT_ALT A  &mt LEFT_SHIFT E  &kp I
&lt 4 X         &kp Q      &kp M           &kp W           &kp J                      &kp K                    &lt 4 F        &td_comma        &td_dot           &kp GB_MINUS
                                           &kp SPACE       &thumb_hrm LEFT_SHIFT TAB  &thumb_hrm LEFT_GUI RET  &kp BACKSPACE  &none
&kp DOWN_ARROW  &kp RIGHT  &none           &kp LEFT_ARROW  &kp UP_ARROW
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        nav {
            bindings = <
&kp ESC         &none       &none             &none       &none         &none                     &none           &none         &none            &none
&none           &mkp MCLK   &mkp LCLK         &mkp RCLK   &kp C_BRI_UP  &none                     &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN   &mmv MOVE_RIGHT
&mo 4           &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_BRI_DN  &none                     &kp C_VOL_DN    &kp C_MUTE    &kp C_VOLUME_UP  &none
                                              &to 0       &mkp MCLK     &ht_mkp_kp LEFT_WIN RCLK  &mkp LCLK       &none
&kp DOWN_ARROW  &kp RIGHT   &none             &kp LEFT    &kp UP_ARROW
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        num-sym {
            bindings = <
&mt QUESTION EXCL  &kp APOS      &kp GB_HASH   &td_dollar_eur  &kp PERCENT          &kp AMPS      &td_slash         &kp ASTERISK  &kp MINUS  &kp GB_AT
&kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4    &kp N5               &kp NUMBER_6  &kp N7            &kp N8        &kp N9     &kp N0
&kp GB_PIPE        &kp CARET     &td_left_par  &td_right_par   &td_angular_bracket  &kp GRAVE     &kp GB_BACKSLASH  &kp PLUS      &kp EQUAL  &kp GB_TILDE
                                               &to 0           &trans               &trans        &trans            &trans
&trans             &trans        &trans        &trans          &trans
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        ext {
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &none   &kp F7  &kp F8  &kp F9  &kp F10
&none           &none         &bt BT_PRV      &bt BT_NXT      &out OUT_BLE  &none   &kp F4  &kp F5  &kp F6  &kp F11
&bootloader     &bt BT_CLR    &bt BT_CLR_ALL  &none           &out OUT_USB  &none   &kp F1  &kp F2  &kp F3  &kp F12
                                              &to 0           &trans        &trans  &trans  &trans
&kp DOWN_ARROW  &kp RIGHT     &trans          &kp LEFT_ARROW  &kp UP_ARROW
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        tools {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &undo   &copy   &paste  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };
    };
};
