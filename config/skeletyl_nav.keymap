// Define scroll speed BEFORE including pointing.h
// #define ZMK_POINTING_DEFAULT_MOVE_VAL 600

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1100
#define ZMK_POINTING_DEFAULT_SCRL_VAL 2500

// #define ZMK_MOUSE_DEFAULT_SCRL_VAL 300
//#include <locale/keys_en_gb_extended.h>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        td_dot: td_dot {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_DOT";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
        };

        td_comma: td_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
        };

        td_angular_bracket: td_angular_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ANGULAR_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp GREATER_THAN>, <&kp LESS_THAN>;
        };

        td_slash_quest_excl: td_slash_quest_excl {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SLASH_QUEST_EXCL";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp EXCL>, <&kp QUESTION>;
        };

        td_left_par: td_left_par {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LEFT_PAR";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_PARENTHESIS>,
                <&kp LEFT_BRACKET>,
                <&kp LEFT_BRACE>;
        };

        td_right_par: td_right_par {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RIGHT_PAR";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_PARENTHESIS>,
                <&kp RIGHT_BRACKET>,
                <&kp RIGHT_BRACE>;
        };

        td_slash: td_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SLASH";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BACKSLASH>;
        };

        mouse_scroll: sensor_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_SCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        morph_left_nav: morph_left_nav {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_LEFT_NAV";
            bindings = <&kp LEFT>, <&to 1>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        morph_right_num: morph_right_num {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_RIGHT_NUM";
            bindings = <&kp RIGHT>, <&to 2>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        morph_up_ext: morph_up_ext {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_UP_EXT";
            bindings = <&kp UP_ARROW>, <&to 3>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        td_b_esc: td_b_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_B_ESC";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp ESCAPE>;
        };

        ht_mkp_kp: ht_mkp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_MKP_KP";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        middle_mouse {
            bindings = <&mkp MCLK>;
            key-positions = <33 32>;
            layers = <1>;
        };

        caps_lock {
            bindings = <&kp CAPS>;
            key-positions = <20 29>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&td_b_esc       &kp L             &kp D           &kp C            &kp V               &kp Z             &kp Y          &kp O            &kp U    &td_slash_quest_excl
&kp N           &kp R             &mt LEFT_ALT T  &mt LCTRL S      &kp G               &kp P             &mt RCTRL H    &mt RIGHT_ALT A  &kp E    &kp I
&kp X           &kp Q             &kp M           &kp W            &kp J               &kp K             &lt 4 F        &td_comma        &td_dot  &td_angular_bracket
                                                  &kp SPACE        &mt LEFT_SHIFT TAB  &mt LEFT_GUI RET  &kp BACKSPACE  &kp A
&kp DOWN_ARROW  &morph_right_num  &kp A           &morph_left_nav  &morph_up_ext
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        nav {
            bindings = <
&trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &none         &none                     &none           &none         &none            &none
&none   &mkp MCLK   &mkp LCLK         &mkp LCLK   &kp C_BRI_UP  &none                     &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN   &mmv MOVE_RIGHT
&none   &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_BRI_DN  &none                     &kp C_VOL_DN    &kp K_MUTE    &kp C_VOLUME_UP  &none
                                      &to 0       &none         &ht_mkp_kp LEFT_WIN RCLK  &mkp LCLK       &none
&trans  &trans      &none             &trans      &trans
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        num-sym {
            bindings = <
&mt EXCL QUESTION  &kp APOS      &kp POUND     &kp DOLLAR     &kp PERCENT          &kp AMPS      &td_slash  &kp ASTERISK  &kp MINUS  &kp AT
&kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp N5               &kp NUMBER_6  &kp N7     &kp N8        &kp N9     &kp N0
&kp PIPE           &kp CARET     &td_left_par  &td_right_par  &td_angular_bracket  &kp GRAVE     &none      &kp PLUS      &kp EQUAL  &kp TILDE
                                               &to 0          &trans               &trans        &trans     &trans
&trans             &trans        &trans        &trans         &trans
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        ext {
            bindings = <
&none        &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &none   &kp F7  &kp F8  &kp F9  &kp F10
&none        &none         &bt BT_PRV      &bt BT_NXT    &out OUT_BLE  &none   &kp F4  &kp F5  &kp F6  &kp F11
&bootloader  &bt BT_CLR    &bt BT_CLR_ALL  &none         &out OUT_USB  &none   &kp F1  &kp F2  &kp F3  &kp F12
                                           &to 0         &trans        &trans  &trans  &trans
&trans       &trans        &trans          &trans        &trans
            >;

            sensor-bindings = <&mouse_scroll SCRL_UP SCRL_DOWN>;
        };

        volume {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };
    };
};
