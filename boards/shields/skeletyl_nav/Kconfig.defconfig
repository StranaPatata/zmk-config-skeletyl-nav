if SHIELD_SKELETYL_NAV_LEFT

config ZMK_KEYBOARD_NAME
    default "Skeletyl-nav"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_SKELETYL_NAV_LEFT

if SHIELD_SKELETYL_NAV_LEFT || SHIELD_SKELETYL_NAV_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_SKELETYL_NAV_LEFT || SHIELD_SKELETYL_NAV_RIGHT


if SHIELD_SKELETYL_NAV_DONGLE

config ZMK_KEYBOARD_NAME
    default "Skeletyl-Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Two split peripherals: left and right halves
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Two halves + five host Bluetooth profiles
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7
 
endif # SHIELD_SKELETYL_NAV_DONGLE
